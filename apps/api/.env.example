# All values below are optional; every field has a safe default in
# apps/api/zion_api/core/config.py. Copy this file to `.env` for local
# development only — never commit a real `.env`.
#
# The docker-compose Postgres credentials below are synthetic local-development
# defaults only, matching infra/docker-compose.yml. They are not secrets.

ZION_ENVIRONMENT=development
ZION_DATABASE_URL=postgresql+psycopg://zion:zion@localhost:5432/zion
ZION_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ZION_SESSION_TOKEN_TTL_MINUTES=720
ZION_LOG_LEVEL=INFO
